#!/usr/bin/env python3
import os, subprocess, socket, ssl
import requests, json
from datetime import datetime
from colorama import Fore, Style

REPORT_DIR = "reports"
os.makedirs(REPORT_DIR, exist_ok=True)

def banner():
    print("="*50)
    print(Fore.CYAN + " AI-Powered OSINT & VAPT Toolkit " + Style.RESET_ALL)
    print("="*50)

def whois_lookup(domain):
    print("\n[+] Running WHOIS lookup...")
    try:
        result = subprocess.run(["whois", domain], capture_output=True, text=True, timeout=15)
        return result.stdout if result.returncode == 0 else "WHOIS lookup failed."
    except:
        return "WHOIS lookup failed."

def crtsh_subdomains(domain):
    print("[+] Gathering subdomains from crt.sh...")
    url = f"https://crt.sh/?q=%25.{domain}&output=json"
    try:
        res = requests.get(url, timeout=15)
        if res.status_code == 200:
            data = res.json()
            subdomains = set(entry['name_value'] for entry in data)
            return sorted(subdomains)
        else:
            return ["Failed to fetch subdomains."]
    except:
        return ["Failed to fetch subdomains."]

def dns_lookup(domain):
    print("[+] Performing DNS lookup...")
    try:
        result = subprocess.run(["dig", domain, "ANY", "+short"], capture_output=True, text=True, timeout=15)
        return result.stdout.strip() or "No DNS records found."
    except:
        return "DNS lookup failed."

def http_headers(domain):
    print("[+] Fetching HTTP headers...")
    try:
        res = requests.get(f"https://{domain}", timeout=15, verify=False)
        return dict(res.headers)
    except:
        return "Failed to fetch HTTP headers."

def ssl_info(domain):
    print("[+] Collecting SSL certificate info...")
    try:
        ctx = ssl.create_default_context()
        with ctx.wrap_socket(socket.socket(), server_hostname=domain) as s:
            s.settimeout(5)
            s.connect((domain, 443))
            cert = s.getpeercert()
            return cert
    except:
        return "Failed to fetch SSL info."

def nmap_scan(domain):
    print("[+] Running Nmap scan...")
    try:
        result = subprocess.run(["nmap", "-sV", domain], capture_output=True, text=True, timeout=120)
        return result.stdout
    except:
        return "Nmap scan failed."

def nikto_scan(domain):
    print("[+] Running Nikto scan...")
    try:
        result = subprocess.run(["nikto", "-h", domain], capture_output=True, text=True, timeout=120)
        return result.stdout
    except:
        return "Nikto scan failed."

def save_report(domain, content):
    filename = os.path.join(REPORT_DIR, f"{domain.replace('.', '_')}.txt")
    with open(filename, "w") as f:
        f.write(content)
    print(f"[✔] Report saved to {filename}")
    # Auto open
    os.system(f"less {filename}")

def main():
    banner()
    domain = input(Fore.GREEN + "Enter target domain or IP: " + Style.RESET_ALL).strip()

    report = f"Generated: {datetime.utcnow().isoformat()}\n"
    report += "="*50 + "\n\n"
    report += "--- WHOIS ---\n" + whois_lookup(domain) + "\n\n"
    report += "--- Subdomains (crt.sh) ---\n" + "\n".join(crtsh_subdomains(domain)) + "\n\n"
    report += "--- DNS Records ---\n" + dns_lookup(domain) + "\n\n"
    report += "--- HTTP Headers ---\n" + str(http_headers(domain)) + "\n\n"
    report += "--- SSL Certificate Info ---\n" + str(ssl_info(domain)) + "\n\n"
    report += "--- Nmap Scan ---\n" + nmap_scan(domain) + "\n\n"
    report += "--- Nikto Scan ---\n" + nikto_scan(domain) + "\n\n"

    save_report(domain, report)

if __name__ == "__main__":
    main()
